rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    match /users/{userId} {
      allow get, create: if true;
      allow update: if true; 

      function isValidUser(data) {
        return data.keys().hasAll(['id', 'name', 'phone', 'password', 'loyaltyPoints']) &&
               data.name is string && data.name.size() <= 100 &&
               data.phone is string && data.phone.size() <= 20 &&
               data.password is string && data.password.size() >= 4 &&
               data.loyaltyPoints is int;
      }
    }

    match /orders/{orderId} {
      allow get, list, create, update: if true; 
    }

    match /products/{productId} {
      allow get, list, create, update, delete: if true;
    }
  }
}

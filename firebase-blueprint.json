{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user account information and preferences.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "loyaltyPoints": { "type": "integer" }
      },
      "required": ["id", "name", "email", "loyaltyPoints"]
    },
    "Order": {
      "title": "Order",
      "description": "Represents a coffee order placed by a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["ORDER PLACED", "CONFIRMED", "PREPARING", "READY", "OUT FOR DELIVERY", "DELIVERED"] },
        "total": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "deliveryMethod": { "type": "string", "enum": ["Delivery", "Pickup"] },
        "paymentMethod": { "type": "string" }
      },
      "required": ["id", "userId", "status", "total", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profile data."
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of all coffee orders."
    }
  }
}
